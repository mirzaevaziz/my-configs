// Place your key bindings in this file to override the defaults.
[
  // General Editing
  {
    "key": "shift+cmd+d",
    "command": "editor.action.duplicateSelection",
  },
  {
    "key": "ctrl+shift+p",
    "command": "editor.action.triggerParameterHints",
    "when": "editorHasSignatureHelpProvider && editorTextFocus",
  },
  {
    "key": "shift+cmd+space",
    "command": "-editor.action.triggerParameterHints",
    "when": "editorHasSignatureHelpProvider && editorTextFocus",
  },

  // Save / File Behavior Overrides
  {
    "key": "shift+cmd+s",
    "command": "-workbench.action.files.saveAs",
  },
  {
    "key": "shift+cmd+s",
    "command": "-workbench.action.files.saveLocalFile",
    "when": "remoteFileDialogVisible",
  },

  // Editor Navigation and Layout — hjkl on four modifiers
  //
  //   cmd+hjkl        j/k traverse editors, h/l cycle groups
  //   cmd+shift+hjkl  move the editor to the group in that direction
  //   cmd+opt+hjkl    focus the group in that direction
  //   cmd+ctrl+h/l    resize the focused view; cmd+ctrl+j/k reorder tab in group
  //
  // cmd+h requires macOS "Hide" to be reassigned first, per machine:
  //   defaults write com.microsoft.VSCode NSUserKeyEquivalents \
  //     -dict-add "Hide Visual Studio Code" '@~^$h'
  // These sit *above* the suggest/quick-open/terminal blocks on purpose — those
  // have `when` clauses and are later in the file, so they still win in context.
  {
    "key": "cmd+h",
    "command": "workbench.action.focusPreviousGroup",
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.previousEditor",
    "when": "!terminalFocus || terminalEditorFocus",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.nextEditor",
    "when": "!terminalFocus || terminalEditorFocus",
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.focusNextGroup",
  },
  {
    "key": "cmd+shift+k",
    "command": "-editor.action.deleteLines",
    "when": "textInputFocus && !editorReadonly",
  },
  {
    "key": "cmd+shift+h",
    "command": "workbench.action.moveEditorToLeftGroup",
  },
  {
    "key": "cmd+shift+j",
    "command": "workbench.action.moveEditorToBelowGroup",
  },
  {
    "key": "cmd+shift+k",
    "command": "workbench.action.moveEditorToAboveGroup",
  },
  {
    "key": "cmd+shift+l",
    "command": "workbench.action.moveEditorToRightGroup",
  },
  // cmd+l would otherwise lose to expandLineSelection
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "textInputFocus",
  },
  // cmd+opt+hjkl — spatial group focus
  {
    "key": "alt+cmd+h",
    "command": "workbench.action.focusLeftGroup",
  },
  {
    "key": "alt+cmd+j",
    "command": "workbench.action.focusBelowGroup",
  },
  {
    "key": "alt+cmd+k",
    "command": "workbench.action.focusAboveGroup",
  },
  {
    "key": "alt+cmd+l",
    "command": "workbench.action.focusRightGroup",
  },
  // cmd+ctrl+h/l — resize the focused view (sidebar or editor group)
  {
    "key": "cmd+ctrl+h",
    "command": "workbench.action.decreaseViewSize",
  },
  {
    "key": "cmd+ctrl+l",
    "command": "workbench.action.increaseViewSize",
  },
  {
    "key": "cmd+ctrl+j",
    "command": "moveActiveEditor",
    "args": {
      "to": "left",
    },
  },
  {
    "key": "cmd+ctrl+k",
    "command": "moveActiveEditor",
    "args": {
      "to": "right",
    },
  },
  // cmd+opt+f — maximize the focused editor group (hides sidebar/panel).
  // Scoped to !findWidgetVisible so the default toggleFindReplace still owns
  // the key whenever the find widget is open.
  {
    "key": "alt+cmd+f",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "!findWidgetVisible",
  },
  // cmd+opt+z — zen mode (esc esc to exit)
  {
    "key": "alt+cmd+z",
    "command": "workbench.action.toggleZenMode",
  },

  // Suggest Widget and Quick Open Traversal
  {
    "key": "cmd+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "cmd+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen",
  },

  // List Navigation (Vim-style)
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "listFocus && !inputFocus",
  },

  // Terminal Management and Focus
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "when": "terminalFocus",
    "args": {
      "text": "\u001b\r",
    },
  },
  {
    "key": "cmd+enter",
    "command": "workbench.action.terminal.toggleTerminal",
  },
  {
    "key": "cmd+ctrl+enter",
    "command": "workbench.action.toggleMaximizedPanel",
  },
  {
    "key": "shift+cmd+enter",
    "command": "workbench.action.createTerminalEditor",
  },
  {
    "key": "cmd+d",
    "command": "workbench.action.terminal.newInActiveWorkspace",
    "when": "terminalFocus && terminalProcessSupported",
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "cmd+j",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "alt+cmd+down",
    "command": "-workbench.action.terminal.focusNextPane",
    "when": "terminalFocus && terminalProcessSupported",
  },
  {
    "key": "alt+cmd+up",
    "command": "-workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus && terminalProcessSupported",
  },
  {
    "key": "cmd+]",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "shift+cmd+]",
    "command": "-workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "cmd+[",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "shift+cmd+[",
    "command": "-workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "shift+cmd+[",
    "command": "-workbench.action.previousEditor",
  },
  {
    "key": "shift+cmd+]",
    "command": "-workbench.action.nextEditor",
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus",
  },
  {
    "key": "cmd+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "terminalEditorFocus || activeEditorId == 'workbench.editor.terminal'",
  },
  {
    "key": "ctrl+escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+alt+w",
    "command": "workbench.action.closePanel",
  },

  // Explorer and Source Control Views
  {
    "key": "cmd+e",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "shift+cmd+e",
    "command": "-workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "cmd+m",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active",
  },
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active",
  },

  // Testing Shortcuts
  // Override pair: old debug key -> rerun last test
  {
    "key": "cmd+; cmd+l",
    "command": "-testing.debugLastRun",
  },
  {
    "key": "cmd+; cmd+l",
    "command": "testing.reRunLastRun",
  },
  // Standalone disable: remove alternate rerun binding
  {
    "key": "cmd+; l",
    "command": "-testing.reRunLastRun",
  },

  // Chat / Copilot Overrides
  {
    "key": "shift+alt+cmd+l",
    "command": "-workbench.action.quickchat.toggle",
    "when": "chatIsEnabled",
  },

  // Extension bindings cleared off alt+cmd+j/k, now spatial group focus
  {
    "key": "alt+cmd+k",
    "command": "-rest-client.cancel-request",
    "when": "editorTextFocus && editorLangId == 'http'",
  },
  {
    "key": "alt+cmd+k",
    "command": "-claude-code.insertAtMentioned",
    "when": "editorTextFocus",
  },
  {
    "key": "alt+cmd+k",
    "command": "-rest-client.cancel-request",
    "when": "editorTextFocus && editorLangId == 'plaintext'",
  },
  {
    "key": "alt+cmd+j",
    "command": "-editor.action.insertSnippet",
    "when": "editorTextFocus && !editorReadonly && editorLangId == 'powershell'",
  },
]
