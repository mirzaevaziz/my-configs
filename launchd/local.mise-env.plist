<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.mise-env</string>
	<!-- GUI apps (Dock, Finder, Raycast) never run config.fish: give them mise's shims and .NET root.
	     sh expands $HOME, so the plist holds no username. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>launchctl setenv PATH "$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"; launchctl setenv DOTNET_ROOT "$HOME/.local/share/mise/dotnet-root"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
